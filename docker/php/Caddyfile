# Caddyfile FrankenPHP pour Laravel
#
#   SERVER_NAME  : nom de domaine à matcher. Par défaut ":80" afin de répondre
#                  à n'importe quel Host (utile derrière un reverse proxy type
#                  Traefik/Dokploy qui conserve le Host d'origine).
#   Le conteneur écoute sur le port 80 (ENV FRANKENPHP_SERVER_PORT si besoin).

{$SERVER_NAME::80} {
    root * /app/public

    # Compression
    encode zstd br gzip

    # En-têtes de sécurité
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Assets versionnés par Vite : cache immuable
    @assets path /build/* /favicon.ico /robots.txt
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Fichiers téléversés : cache court (le contenu peut changer)
    @uploads path /storage/*
    header @uploads Cache-Control "public, max-age=86400"

    # Interdiction d'exposer des fichiers sensibles
    @denied path /.env* /.git/* /database/* /storage/*.key
    respond @denied 404

    # Fichiers publics existants -> servis en statique.
    # Les URL finissant par "/" (répertoires) sont exclues pour qu'elles
    # soient traitées par le front controller et non servies par file_server.
    @static file {
        try_files {path} =404
        not path */
    }
    handle @static {
        file_server
    }

    # Tout le reste -> index.php (routes Laravel)
    handle {
        rewrite * /index.php
        frankenphp
    }

    log {
        output stderr
        format console
    }
}
